# 复制本文件为 .env 后填入自己的值（.env 已被 .gitignore 忽略，不会被提交）

# 深大统一身份认证学号
SZU_STUDENT_ID=

# 深大统一身份认证密码
SZU_PASSWORD=

# 二次验证渠道（reAuthType）
#   4  = 企业微信验证码（默认，推荐；短信被风控时用它）
#   3  = 短信验证码
#   5  = 今日校园
#   11 = 邮箱验证码
#   12 = 钉钉验证码
#   13 = WeLink 验证码
SZU_MFA_CHANNEL=4

# 设为 1 使用有头模式运行浏览器
# 遇到「请完成安全验证 / 向右滑动填充拼图」时必须设为 1，手动滑一次
SZU_HEADED=0

# 浏览器持久化目录，设备信任（MULTIFACTOR_BROWSER_FINGERPRINT）存在这里
# 删掉它会导致下次又要重新验证
SZU_PROFILE=./browser-profile
